<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 255 64" fill="none">
  <defs>
    <linearGradient id="shield-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C026D3" />
      <stop offset="50%" stop-color="#9333EA" />
      <stop offset="100%" stop-color="#6B21A8" />
    </linearGradient>
    <linearGradient id="pill-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#A21CAF" />
      <stop offset="50%" stop-color="#9333EA" />
      <stop offset="100%" stop-color="#6B21A8" />
    </linearGradient>
  </defs>

  <!-- Purple/Pink Gradient Shield -->
  <g transform="translate(2, 3)">
    <!-- Shield Outline & Fill -->
    <path d="M4 12 C12 10, 24 6, 29 6 C34 6, 46 10, 54 12 C54 37, 42 50, 29 57 C16 50, 4 37, 4 12 Z" 
          fill="url(#shield-grad)" />
    
    <!-- Stylized White "R" -->
    <path d="M18 18 H32 C37 18, 40 21, 40 25 C40 28.5, 37.5 31.5, 33 32 L41.5 44 H35 L27.5 33.5 H23.5 V44 H18 V18 Z M23.5 23 V29 H31 C33 29, 34.5 28, 34.5 26 C34.5 24, 33 23, 31 23 H23.5 Z" 
          fill="#FFFFFF" />

    <!-- Orange / Yellow Accent Triangle -->
    <polygon points="29.5,44 37,44 33.2,37" fill="#F59E0B" />
  </g>

  <!-- Capsule Pill Badge: "UPSKILLING PARTNER" -->
  <rect x="66" y="18" width="182" height="28" rx="14" fill="url(#pill-grad)" />
  <text x="157" y="36.5" 
        font-family="'Plus Jakarta Sans', 'Outfit', system-ui, -apple-system, sans-serif" 
        font-weight="800" 
        font-size="11.5" 
        fill="#FFFFFF" 
        text-anchor="middle" 
        letter-spacing="1.2">UPSKILLING PARTNER</text>
</svg>
